# 複製這個檔案成 .env 再填入自己的值 (.env 不會上傳到 GitHub)

# PostgreSQL 連線字串
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/helmet_lab

# 模型權重路徑 (留空就用預設: )
HELMET_MODEL_PATH=
PLATE_MODEL_PATH=

# 網頁伺服器
HOST=127.0.0.1
PORT=5000
# 必填, 用 python -c "import secrets; print(secrets.token_hex(32))" 產生
FLASK_SECRET_KEY=

# run.bat 用 (Windows)
PYTHON_EXE=C:\path\to\anaconda3\envs\helmet\python.exe
PGBIN=C:\path\to\PostgreSQL\18\bin
PGDATA=C:\path\to\PostgreSQL\18\data
